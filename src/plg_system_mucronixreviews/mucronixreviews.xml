<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_mucronixreviews</name>
	<author>Mucronix</author>
	<creationDate>2026-11</creationDate>
	<copyright>(C) 2026 Mucronix</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>support@mucronix.com</authorEmail>
	<authorUrl>https://mucronix.com</authorUrl>
	<version>0.6.2</version>
	<description>PLG_SYSTEM_MUCRONIXREVIEWS_XML_DESCRIPTION</description>
	<namespace path="src">Mucronix\Plugin\System\MucronixReviews</namespace>
	<files>
		<filename>LICENSE.txt</filename>
		<folder plugin="mucronixreviews">services</folder>
		<folder>src</folder>
		<folder>yootheme</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/plg_system_mucronixreviews.ini</language>
		<language tag="en-GB">language/en-GB/plg_system_mucronixreviews.sys.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_system_mucronixreviews.ini</language>
		<language tag="ru-RU">language/ru-RU/plg_system_mucronixreviews.sys.ini</language>
		<language tag="uk-UA">language/uk-UA/plg_system_mucronixreviews.ini</language>
		<language tag="uk-UA">language/uk-UA/plg_system_mucronixreviews.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="yootheme"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_MUCRONIXREVIEWS_FIELD_YOOTHEME_LABEL"
					description="PLG_SYSTEM_MUCRONIXREVIEWS_FIELD_YOOTHEME_DESC"
					default="1"
					filter="integer"
					validate="options"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
