<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Mucronix\Component\MucronixReviews\Administrator\Field">
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_MUCRONIXREVIEWS_FILTER_SEARCH_LABEL"
			description="COM_MUCRONIXREVIEWS_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="state"
			type="list"
			label="JOPTION_SELECT_PUBLISHED"
			class="js-select-submit-on-change"
			validate="options"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="1">COM_MUCRONIXREVIEWS_STATE_PUBLISHED</option>
			<option value="0">COM_MUCRONIXREVIEWS_STATE_PENDING</option>
			<option value="-1">COM_MUCRONIXREVIEWS_STATE_REJECTED</option>
			<option value="-3">COM_MUCRONIXREVIEWS_STATE_SPAM</option>
			<option value="-2">JTRASHED</option>
			<option value="*">JALL</option>
		</field>
		<field
			name="context"
			type="contexttype"
			label="COM_MUCRONIXREVIEWS_FILTER_CONTEXT"
			class="js-select-submit-on-change"
			>
			<option value="">COM_MUCRONIXREVIEWS_FILTER_CONTEXT</option>
		</field>
		<field
			name="rating"
			type="list"
			label="COM_MUCRONIXREVIEWS_FILTER_RATING"
			class="js-select-submit-on-change"
			validate="options"
			>
			<option value="">COM_MUCRONIXREVIEWS_FILTER_RATING</option>
			<option value="5">5</option>
			<option value="4">4</option>
			<option value="3">3</option>
			<option value="2">2</option>
			<option value="1">1</option>
		</field>
		<field
			name="user_id"
			type="user"
			label="COM_MUCRONIXREVIEWS_FILTER_AUTHOR"
			class="js-select-submit-on-change"
		/>
		<field
			name="with_text"
			type="list"
			label="COM_MUCRONIXREVIEWS_FILTER_WITH_TEXT"
			class="js-select-submit-on-change"
			validate="options"
			>
			<option value="">COM_MUCRONIXREVIEWS_FILTER_WITH_TEXT</option>
			<option value="1">COM_MUCRONIXREVIEWS_FILTER_WITH_TEXT_ONLY</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			class="js-select-submit-on-change"
			default="a.created DESC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.rating ASC">COM_MUCRONIXREVIEWS_RATING_ASC</option>
			<option value="a.rating DESC">COM_MUCRONIXREVIEWS_RATING_DESC</option>
			<option value="a.context ASC">COM_MUCRONIXREVIEWS_OBJECT_ASC</option>
			<option value="a.context DESC">COM_MUCRONIXREVIEWS_OBJECT_DESC</option>
			<option value="author ASC">JAUTHOR_ASC</option>
			<option value="author DESC">JAUTHOR_DESC</option>
			<option value="a.created ASC">JDATE_ASC</option>
			<option value="a.created DESC">JDATE_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
